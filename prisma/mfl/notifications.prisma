model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  utilisateurId String           @map("utilisateur_id") @db.Uuid
  type          TypeNotification
  titre         String
  contenu       String
  estLu         Boolean          @default(false) @map("est_lu")
  dateCreation  DateTime         @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateLecture   DateTime?        @map("date_lecture") @db.Timestamptz(3)
  utilisateur   Utilisateur      @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@index([type])
  @@index([estLu])
  @@index([dateCreation])
  @@map("notifications")
}

model PreferenceNotification {
  id            String           @id @default(uuid()) @db.Uuid
  utilisateurId String           @map("utilisateur_id") @db.Uuid
  type          TypeNotification
  active        Boolean          @default(true)
  utilisateur   Utilisateur      @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, type])
  @@map("preferences_notifications")
}

model Appareil {
  id                  String             @id @default(uuid()) @db.Uuid
  utilisateurId       String             @map("utilisateur_id") @db.Uuid
  tokenFcm            String             @unique @map("token_fcm")
  plateforme          PlateformeAppareil
  modele              String?
  dateCreation        DateTime           @default(now()) @map("date_creation") @db.Timestamptz(3)
  derniereUtilisation DateTime           @default(now()) @map("derniere_utilisation") @db.Timestamptz(3)
  utilisateur         Utilisateur        @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@index([plateforme])
  @@map("appareils")
}
