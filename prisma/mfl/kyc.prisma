model DossierKyc {
  id             String            @id @default(uuid()) @db.Uuid
  vendeurId      String            @map("vendeur_id") @db.Uuid
  statut         StatutKyc         @default(EN_ATTENTE)
  dateSoumission DateTime          @default(now()) @map("date_soumission") @db.Timestamptz(3)
  dateValidation DateTime?         @map("date_validation") @db.Timestamptz(3)
  dateRejet      DateTime?         @map("date_rejet") @db.Timestamptz(3)
  motifRejet     String?           @map("motif_rejet")
  vendeur        Vendeur           @relation(fields: [vendeurId], references: [id])
  documents      DocumentKyc[]
  verifications  VerificationKyc[]
  revues         RevueKyc[]

  @@index([vendeurId])
  @@index([statut])
  @@map("dossiers_kyc")
}

model DocumentKyc {
  id           String            @id @default(uuid()) @db.Uuid
  dossierKycId String            @map("dossier_kyc_id") @db.Uuid
  typeDocument TypeDocumentKyc   @map("type_document")
  cleStockage  String            @map("cle_stockage")
  nomOriginal  String            @map("nom_original")
  typeMime     String            @map("type_mime")
  taille       BigInt
  statut       StatutDocumentKyc @default(SOUMIS)
  dateCreation DateTime          @default(now()) @map("date_creation") @db.Timestamptz(3)
  dossierKyc   DossierKyc        @relation(fields: [dossierKycId], references: [id], onDelete: Cascade)

  @@index([dossierKycId])
  @@map("documents_kyc")
}

model VerificationKyc {
  id               String                @id @default(uuid()) @db.Uuid
  dossierKycId     String                @map("dossier_kyc_id") @db.Uuid
  typeVerification TypeVerificationKyc   @map("type_verification")
  statut           StatutVerificationKyc @default(EN_ATTENTE)
  commentaire      String?
  dateVerification DateTime?             @map("date_verification") @db.Timestamptz(3)
  scoreMatching    Decimal?              @map("score_matching") @db.Decimal(5, 4)
  seuilDecision    Decimal?              @map("seuil_decision") @db.Decimal(5, 4)
  dossierKyc       DossierKyc            @relation(fields: [dossierKycId], references: [id], onDelete: Cascade)

  @@index([dossierKycId])
  @@index([statut])
  @@map("verifications_kyc")
}

model RevueKyc {
  id               String      @id @default(uuid()) @db.Uuid
  dossierKycId     String      @map("dossier_kyc_id") @db.Uuid
  administrateurId String      @map("administrateur_id") @db.Uuid
  statut           StatutKyc
  commentaire      String?
  dateRevue        DateTime    @default(now()) @map("date_revue") @db.Timestamptz(3)
  dossierKyc       DossierKyc  @relation(fields: [dossierKycId], references: [id], onDelete: Cascade)
  administrateur   Utilisateur @relation("AdministrateurRevueKyc", fields: [administrateurId], references: [id])

  @@index([dossierKycId])
  @@index([administrateurId])
  @@map("revues_kyc")
}

