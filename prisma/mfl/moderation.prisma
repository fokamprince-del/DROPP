model Signalement {
  id            String              @id @default(uuid()) @db.Uuid
  utilisateurId String              @map("utilisateur_id") @db.Uuid
  publicationId String?             @map("publication_id") @db.Uuid
  commentaireId String?             @map("commentaire_id") @db.Uuid
  produitId     String?             @map("produit_id") @db.Uuid
  motif         String
  description   String?
  statut        StatutSignalement   @default(OUVERT)
  priorite      PrioriteSignalement @default(NORMALE)
  dateCreation  DateTime            @default(now()) @map("date_creation") @db.Timestamptz(3)
  utilisateur   Utilisateur         @relation("EmetteurSignalement", fields: [utilisateurId], references: [id])
  publication   Publication?        @relation(fields: [publicationId], references: [id])
  commentaire   Commentaire?        @relation(fields: [commentaireId], references: [id])
  produit       Produit?            @relation(fields: [produitId], references: [id])

  @@index([utilisateurId])
  @@index([publicationId])
  @@index([commentaireId])
  @@index([produitId])
  @@index([statut])
  @@index([priorite])
  @@map("signalements")
}

model DossierModeration {
  id               String           @id @default(uuid()) @db.Uuid
  administrateurId String?          @map("administrateur_id") @db.Uuid
  statut           StatutModeration @default(OUVERT)
  action           ActionModeration @default(AUCUNE)
  dateCreation     DateTime         @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateCloture      DateTime?        @map("date_cloture") @db.Timestamptz(3)
  administrateur   Utilisateur?     @relation("AdministrateurModeration", fields: [administrateurId], references: [id])

  @@index([administrateurId])
  @@index([statut])
  @@map("dossiers_moderation")
}

model Litige {
  id             String          @id @default(uuid()) @db.Uuid
  commandeId     String          @map("commande_id") @db.Uuid
  utilisateurId  String          @map("utilisateur_id") @db.Uuid
  motif          String
  statut         StatutLitige    @default(OUVERT)
  dateCreation   DateTime        @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateResolution DateTime?       @map("date_resolution") @db.Timestamptz(3)
  commande       ArticleCommande @relation(fields: [commandeId], references: [id])
  utilisateur    Utilisateur     @relation(fields: [utilisateurId], references: [id])
  preuves        PreuveLitige[]

  @@index([commandeId])
  @@index([utilisateurId])
  @@index([statut])
  @@map("litiges")
}

model PreuveLitige {
  id           String           @id @default(uuid()) @db.Uuid
  litigeId     String           @map("litige_id") @db.Uuid
  mediaId      String           @map("media_id") @db.Uuid
  type         TypePreuveLitige
  dateCreation DateTime         @default(now()) @map("date_creation") @db.Timestamptz(3)
  litige       Litige           @relation(fields: [litigeId], references: [id], onDelete: Cascade)
  media        Media            @relation(fields: [mediaId], references: [id])

  @@index([litigeId])
  @@index([mediaId])
  @@map("preuves_litiges")
}

