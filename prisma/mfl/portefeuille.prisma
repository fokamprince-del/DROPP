model Portefeuille {
  id              String                    @id @default(uuid()) @db.Uuid
  utilisateurId   String                    @unique @map("utilisateur_id") @db.Uuid
  type            TypePortefeuille
  solde           Decimal                   @default(0) @db.Decimal(12, 2)
  soldeDisponible Decimal                   @default(0) @map("solde_disponible") @db.Decimal(12, 2)
  devise          String                    @default("XAF")
  statut          StatutPortefeuille        @default(ACTIF)
  dateCreation    DateTime                  @default(now()) @map("date_creation") @db.Timestamptz(3)
  transactions    TransactionPortefeuille[]
  retraits        Retrait[]
  utilisateurs    Utilisateur[]

  @@index([statut])
  @@map("portefeuilles")
}

model TransactionPortefeuille {
  id             String                        @id @default(uuid()) @db.Uuid
  portefeuilleId String                        @map("portefeuille_id") @db.Uuid
  type           TypeTransactionPortefeuille
  montant        Decimal                       @db.Decimal(12, 2)
  devise         String                        @default("XAF")
  statut         StatutTransactionPortefeuille @default(EN_ATTENTE)
  dateCreation   DateTime                      @default(now()) @map("date_creation") @db.Timestamptz(3)
  description    String?
  portefeuille   Portefeuille                  @relation(fields: [portefeuilleId], references: [id])
  ecritures      EcritureComptable[]

  @@index([portefeuilleId])
  @@index([type])
  @@index([statut])
  @@index([dateCreation])
  @@map("transactions_portefeuilles")
}

model Retrait {
  id                String        @id @default(uuid()) @db.Uuid
  portefeuilleId    String        @map("portefeuille_id") @db.Uuid
  montant           Decimal       @db.Decimal(12, 2)
  moyenRetrait      MoyenRetrait  @map("moyen_retrait")
  numeroDestination String        @map("numero_destination")
  statut            StatutRetrait @default(EN_COURS)
  dateCreation      DateTime      @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateExecution     DateTime?     @map("date_execution") @db.Timestamptz(3)
  portefeuille      Portefeuille  @relation(fields: [portefeuilleId], references: [id])

  @@index([portefeuilleId])
  @@index([statut])
  @@map("retraits")
}

// ==== 10. Comptabilite ====
model CompteComptable {
  id        String              @id @default(uuid()) @db.Uuid
  code      String              @unique
  libelle   String
  type      TypeCompteComptable
  ecritures EcritureComptable[]

  @@index([type])
  @@map("comptes_comptables")
}

model JournalComptable {
  id            String                 @id @default(uuid()) @db.Uuid
  date          DateTime               @default(now()) @db.Timestamptz(3)
  typeOperation String                 @map("type_operation")
  description   String?
  statut        StatutJournalComptable @default(BROUILLON)
  ecritures     EcritureComptable[]

  @@index([date])
  @@index([statut])
  @@map("journaux_comptables")
}

model EcritureComptable {
  id                        String                   @id @default(uuid()) @db.Uuid
  journalId                 String                   @map("journal_id") @db.Uuid
  compteId                  String                   @map("compte_id") @db.Uuid
  paiementId                String?                  @map("paiement_id") @db.Uuid
  transactionPortefeuilleId String?                  @map("transaction_portefeuille_id") @db.Uuid
  debit                     Decimal                  @default(0) @db.Decimal(12, 2)
  credit                    Decimal                  @default(0) @db.Decimal(12, 2)
  description               String?
  journal                   JournalComptable         @relation(fields: [journalId], references: [id])
  compte                    CompteComptable          @relation(fields: [compteId], references: [id])
  paiement                  Paiement?                @relation(fields: [paiementId], references: [id])
  transactionPortefeuille   TransactionPortefeuille? @relation(fields: [transactionPortefeuilleId], references: [id])

  @@index([journalId])
  @@index([compteId])
  @@index([paiementId])
  @@index([transactionPortefeuilleId])
  @@map("ecritures_comptables")
}

