model Paiement {
  id String @id @default(uuid()) @db.Uuid
  passageCommandeId String @map("passage_commande_id") @db.Uuid
  montant Decimal @db.Decimal(12,2)
  devise String @default("XAF")
  moyenPaiement MoyenPaiement @map("moyen_paiement")
  statut StatutPaiement @default(EN_ATTENTE)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateConfirmation DateTime? @map("date_confirmation") @db.Timestamptz(3)
  referenceExterne String? @unique @map("reference_externe")
  passageCommande PassageCommande @relation(fields:[passageCommandeId], references:[id])
  tentatives TentativePaiement[]
  allocations AllocationPaiement[]
  ecritures EcritureComptable[]
  @@index([passageCommandeId])
  @@index([statut])
  @@index([dateCreation])
  @@map("paiements")
}
