model TentativePaiement {
  id                   String              @id @default(uuid()) @db.Uuid
  paiementId           String              @map("paiement_id") @db.Uuid
  fournisseur          FournisseurPaiement
  referenceFournisseur String              @map("reference_fournisseur")
  montant              Decimal             @db.Decimal(12, 2)
  statut               StatutPaiement      @default(EN_ATTENTE)
  dateCreation         DateTime            @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateConfirmation     DateTime?           @map("date_confirmation") @db.Timestamptz(3)
  paiement             Paiement            @relation(fields: [paiementId], references: [id], onDelete: Cascade)

  @@unique([fournisseur, referenceFournisseur])
  @@index([paiementId])
  @@index([statut])
  @@map("tentatives_paiements")
}
