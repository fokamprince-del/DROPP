model SousCommande {
  id String @id @default(uuid()) @db.Uuid
  commandeId String @map("commande_id") @db.Uuid
  vendeurId String @map("vendeur_id") @db.Uuid
  statut StatutCommande @default(NOUVELLE)
  montantTotal Decimal @map("montant_total") @db.Decimal(12,2)
  devise String @default("XAF")
  sousTotal Decimal @map("sous_total") @db.Decimal(12,2)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  commande Commande @relation(fields:[commandeId], references:[id], onDelete:Cascade)
  vendeur Vendeur @relation(fields:[vendeurId], references:[id])
  lignes LigneSousCommande[]
  sequestres Sequestre[]
  remboursements Remboursement[]
  litiges Litige[]
  @@index([sousCommandeId])
  @@index([vendeurId])
  @@index([statut])
  @@map("sous_commandes")
}
