  dateModification DateTime @updatedAt @map("date_modification") @db.Timestamptz(3)
  panier Panier @relation(fields:[panierId], references:[id], onDelete:Cascade)
  varianteProduit VarianteProduit @relation(fields:[varianteProduitId], references:[id])
  @@unique([panierId,varianteProduitId])
  @@index([varianteProduitId])
  @@map("articles_paniers")
}
model PassageCommande {
  id String @id @default(uuid()) @db.Uuid
  utilisateurId String @map("utilisateur_id") @db.Uuid
  panierId String @map("panier_id") @db.Uuid
  statut StatutPassageCommande @default(EN_COURS)
  montantTotal Decimal @map("montant_total") @db.Decimal(12,2)
  devise String @default("XAF")
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  utilisateur Utilisateur @relation(fields:[utilisateurId], references:[id])
  panier Panier @relation(fields:[panierId], references:[id])
  commande Commande?
  paiements Paiement[]
  @@index([utilisateurId])
  @@index([panierId])
  @@index([statut])
  @@map("passages_commandes")
}
model Commande {
  id String @id @default(uuid()) @db.Uuid
  passageCommandeId String @unique @map("passage_commande_id") @db.Uuid
  utilisateurId String @map("utilisateur_id") @db.Uuid
  statut StatutCommande @default(EN_ATTENTE_PAIEMENT)
  montantTotal Decimal @map("montant_total") @db.Decimal(12,2)
  devise String @default("XAF")
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  passageCommande PassageCommande @relation(fields:[passageCommandeId], references:[id])
  utilisateur Utilisateur @relation(fields:[utilisateurId], references:[id])
  sousCommandes ArticleCommande[]
  allocationsPaiement AllocationPaiement[]
  @@index([utilisateurId])
  @@index([statut])
  @@index([dateCreation])
  @@map("commandes")
}
// This is the vendor-specific sub-order; it has its own fulfillment lifecycle.
model ArticleCommande {
  id String @id @default(uuid()) @db.Uuid
  commandeId String @map("commande_id") @db.Uuid
  vendeurId String @map("vendeur_id") @db.Uuid
  statut StatutCommande @default(NOUVELLE)
  montantTotal Decimal @map("montant_total") @db.Decimal(12,2)
  devise String @default("XAF")
  sousTotal Decimal @map("sous_total") @db.Decimal(12,2)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  commande Commande @relation(fields:[commandeId], references:[id], onDelete:Cascade)
  vendeur Vendeur @relation(fields:[vendeurId], references:[id])
  lignes LigneArticleCommande[]
  sequestres Sequestre[]
  remboursements Remboursement[]
  litiges Litige[]
  @@index([commandeId])
  @@index([vendeurId])
  @@index([statut])
  @@map("articles_commandes")
}
model LigneArticleCommande {
  id String @id @default(uuid()) @db.Uuid
  articleCommandeId String @map("article_commande_id") @db.Uuid
