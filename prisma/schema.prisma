generator client {
  provider        = "prisma-client"
  output          = "../apps/api/src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum StatutCompte { ACTIF EN_ATTENTE_VERIFICATION SUSPENDU_TEMP SUSPENDU_DEF SUPPRIME }
enum StatutClient { ACTIF SUSPENDU DESACTIVE }
enum StatutVendeur { EN_ATTENTE_VALIDATION ACTIF SUSPENDU }
enum TypeAdresse { LIVRAISON FACTURATION AUTRE }
enum TypeCodeVerification { INSCRIPTION REINITIALISATION_MOT_DE_PASSE }
enum StatutBoutique { EN_ATTENTE ACTIVE SUSPENDUE }
enum JourSemaine { LUNDI MARDI MERCREDI JEUDI VENDREDI SAMEDI DIMANCHE }
enum StatutCategorie { ACTIVE INACTIVE }
enum StatutProduit { BROUILLON PROCESSING PUBLIE REJETE ARCHIVE }
enum TypeMedia { VIDEO IMAGE }
enum StatutTraitementMedia { PROCESSING PRET ECHEC }
enum TypePublication { VIDEO IMAGE CARROUSEL }
enum VisibiliteContenu { PUBLIC ABONNES }
enum StatutPublication { PROCESSING PUBLIEE REJETEE SUPPRIMEE }
enum StatutCommentaire { VISIBLE MASQUE_MODERATION SUPPRIME }
enum StatutAbonnement { ACTIF MUET BLOQUE }
enum TypeConversation { DIRECTE }
enum StatutConversation { ACTIVE ARCHIVEE FERMEE }
enum TypeMessage { TEXTE IMAGE VIDEO FICHIER }
enum StatutMessage { ENVOYE LU }
enum StatutKyc { EN_ATTENTE VALIDE REJETE }
enum TypeDocumentKyc { CNI_RECTO CNI_VERSO PHOTO_FACIALE }
enum StatutDocumentKyc { SOUMIS VALIDE REJETE }
enum TypeVerificationKyc { FACIALE MANUELLE }
enum StatutVerificationKyc { EN_ATTENTE VALIDE REJETE ERREUR }
enum StatutPanier { ACTIF ABANDONNE CONVERTI }
enum StatutPassageCommande { EN_COURS COMPLETE EXPIRE ANNULE }
enum StatutCommande { EN_ATTENTE_PAIEMENT NOUVELLE EN_COURS EXPEDIEE LIVREE ANNULEE EN_LITIGE }
enum MoyenPaiement { MOBILE_MONEY_MTN MOBILE_MONEY_ORANGE }
enum StatutPaiement { EN_ATTENTE SUCCES ECHOUE ANNULE REMBOURSE }
enum FournisseurPaiement { CAMPAY MONETBIL }
enum StatutSequestre { BLOQUE LIBERE REMBOURSE }
enum TypeRemboursement { TOTAL PARTIEL }
enum StatutRemboursement { EN_ATTENTE EFFECTUE ECHOUE }
enum StatutRetrait { EN_ATTENTE EN_COURS EFFECTUE ECHOUE ANNULE }
enum TypeTransactionPortefeuille { CREDIT DEBIT }
enum TypeCompteComptable { ACTIF PASSIF CHARGE PRODUIT }
enum StatutJournalComptable { BROUILLON VALIDE ANNULE }
enum StatutSignalement { OUVERT EN_COURS TRAITE REJETE }
enum PrioriteSignalement { BASSE NORMALE HAUTE CRITIQUE }
enum StatutModeration { OUVERT EN_COURS CLOTURE }
enum ActionModeration { AUCUNE MASQUER SUPPRIMER SUSPENDRE REJETER }
enum StatutLitige { OUVERT EN_ARBITRAGE RESOLU }
enum TypePreuveLitige { PHOTO VIDEO DOCUMENT }
enum TypeNotification { COMMANDE PAIEMENT MESSAGE PROMOTION SYSTEME SECURITE }
enum PlateformeAppareil { ANDROID IOS }

model Utilisateur {
  id String @id @default(uuid()) @db.Uuid
  nom String
  prenom String
  email String @unique
  telephone String @unique
  motDePasseHash String @map("mot_de_passe_hash")
  photoProfilUrl String? @map("photo_profil_url")
  dateInscription DateTime @default(now()) @map("date_inscription") @db.Timestamptz(3)
  statutCompte StatutCompte @default(ACTIF) @map("statut_compte")
  derniereConnexion DateTime? @map("derniere_connexion") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  client Client?
  vendeur Vendeur?
  sessions Session[]
  codesVerification CodeVerification[]
  reinitialisationsMotDePasse ReinitialisationMotDePasse[]
  roles UtilisateurRole[]
  adressesLivraison Adresse[]
  likes Aime[]
  commentaires Commentaire[]
  favorisPublications FavoriPublication[]
  favorisProduits FavoriProduit[]
  abonnements Abonnement[]
  participants ParticipantConversation[]
  messagesEnvoyes Message[] @relation("ExpediteurMessage")
  revuesKyc RevueKyc[] @relation("AdministrateurRevueKyc")
  paniers Panier[]
  passagesCommande PassageCommande[]
  commandes Commande[]
  signalements Signalement[] @relation("EmetteurSignalement")
  litiges Litige[]
  avis Avis[]
  notifications Notification[]
  preferencesNotification PreferenceNotification[]
  appareils Appareil[]
  dossiersModeration DossierModeration[] @relation("AdministrateurModeration")
  audits JournalAudit[] @relation("AdministrateurAudit")
  @@map("utilisateurs")
}

model Client {
  id String @id @db.Uuid
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  statutClient StatutClient @default(ACTIF) @map("statut_client")
  utilisateur Utilisateur @relation(fields: [id], references: [id], onDelete: Cascade)
  adresses Adresse[]
  @@map("clients")
}

model Vendeur {
  id String @id @db.Uuid
  dateDebut DateTime @default(now()) @map("date_debut") @db.Timestamptz(3)
  statutVendeur StatutVendeur @default(EN_ATTENTE_VALIDATION) @map("statut_vendeur")
  commissionPersonnalisee Decimal? @map("commission_personnalisee") @db.Decimal(12, 2)
  biographie String?
  utilisateur Utilisateur @relation(fields: [id], references: [id], onDelete: Cascade)
  boutique Boutique?
  abonnements Abonnement[]
  dossiersKyc DossierKyc[]
  articlesCommande ArticleCommande[]
  portefeuille Portefeuille?
  @@index([statutVendeur])
  @@map("vendeurs")
}

model Role {
  id String @id @default(uuid()) @db.Uuid
  nom String @unique
  description String?
  utilisateurs UtilisateurRole[]
  @@map("roles")
}

model UtilisateurRole {
  utilisateurId String @map("utilisateur_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  dateAttribution DateTime @default(now()) @map("date_attribution") @db.Timestamptz(3)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([utilisateurId, roleId])
  @@index([roleId])
  @@map("utilisateur_roles")
}

model Adresse {
  id String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  type TypeAdresse
  ligne1 String
  ligne2 String?
  ville String
  region String?
  pays String
  codePostal String? @map("code_postal")
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  estPrincipale Boolean @default(false) @map("est_principale")
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@index([clientId])
  @@index([type])
  @@map("adresses")
}

model CodeVerification {
  id String @id @default(uuid()) @db.Uuid
  utilisateurId String? @map("utilisateur_id") @db.Uuid
  destination String
  codeHash String @map("code_hash")
  type TypeCodeVerification
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateExpiration DateTime @map("date_expiration") @db.Timestamptz(3)
  nombreTentatives Int @default(0) @map("nombre_tentatives")
  dateUtilisation DateTime? @map("date_utilisation") @db.Timestamptz(3)
  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  @@index([utilisateurId])
  @@index([destination, type])
  @@index([dateExpiration])
  @@map("codes_verification")
}

model ReinitialisationMotDePasse {
  id String @id @default(uuid()) @db.Uuid
  utilisateurId String @map("utilisateur_id") @db.Uuid
  jetonHash String @map("jeton_hash")
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateExpiration DateTime @map("date_expiration") @db.Timestamptz(3)
  dateUtilisation DateTime? @map("date_utilisation") @db.Timestamptz(3)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  @@index([utilisateurId])
  @@index([dateExpiration])
  @@map("reinitialisations_mots_de_passe")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  utilisateurId String @map("utilisateur_id") @db.Uuid
  jetonRafraichissementHash String @map("jeton_rafraichissement_hash")
  familleJeton String @map("famille_jeton")
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateExpiration DateTime @map("date_expiration") @db.Timestamptz(3)
  dateDerniereUtilisation DateTime? @map("date_derniere_utilisation") @db.Timestamptz(3)
  dateRevocation DateTime? @map("date_revocation") @db.Timestamptz(3)
  adresseIpCreation String? @map("adresse_ip_creation")
  appareilId String? @map("appareil_id") @db.Uuid
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  appareil Appareil? @relation(fields: [appareilId], references: [id], onDelete: SetNull)
  @@index([utilisateurId])
  @@index([familleJeton])
  @@index([dateExpiration])
  @@map("sessions")
}

model Boutique {
  id String @id @db.Uuid
  nom String
  description String?
  biographie String?
  statut StatutBoutique @default(EN_ATTENTE)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateModification DateTime @updatedAt @map("date_modification") @db.Timestamptz(3)
  vendeur Vendeur @relation(fields: [id], references: [id], onDelete: Cascade)
  localisation LocalisationBoutique?
  horaires HoraireBoutique[]
  contacts ContactBoutique[]
  produits Produit[]
  publications Publication[]
  stories Story[]
  @@index([statut])
  @@map("boutiques")
}

model LocalisationBoutique {
  id String @id @default(uuid()) @db.Uuid
  boutiqueId String @unique @map("boutique_id") @db.Uuid
  adresse String?
  ville String
  quartier String?
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  position Unsupported("geography(Point,4326)")?
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  @@map("localisations_boutiques")
}

model HoraireBoutique {
  id String @id @default(uuid()) @db.Uuid
  boutiqueId String @map("boutique_id") @db.Uuid
  jour JourSemaine
  ouvert Boolean @default(true)
  heureOuverture DateTime? @map("heure_ouverture") @db.Time(0)
  heureFermeture DateTime? @map("heure_fermeture") @db.Time(0)
  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  @@unique([boutiqueId, jour])
  @@index([boutiqueId])
  @@map("horaires_boutiques")
}

model ContactBoutique {
  id String @id @default(uuid()) @db.Uuid
  boutiqueId String @map("boutique_id") @db.Uuid
  type String
  valeur String
  estPrincipal Boolean @default(false) @map("est_principal")
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  @@index([boutiqueId])
  @@map("contacts_boutiques")
}

model Categorie {
  id String @id @default(uuid()) @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  nom String
  description String?
  statut StatutCategorie @default(ACTIVE)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  parent Categorie? @relation("HierarchieCategorie", fields: [parentId], references: [id])
  enfants Categorie[] @relation("HierarchieCategorie")
  produits Produit[]
  @@index([parentId])
  @@index([statut])
  @@map("categories")
}

model Produit {
  id String @id @default(uuid()) @db.Uuid
  boutiqueId String @map("boutique_id") @db.Uuid
  categorieId String @map("categorie_id") @db.Uuid
  nom String
  description String?
  statut StatutProduit @default(BROUILLON)
  prixBase Decimal @map("prix_base") @db.Decimal(12, 2)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateModification DateTime @updatedAt @map("date_modification") @db.Timestamptz(3)
  boutique Boutique @relation(fields: [boutiqueId], references: [id])
  categorie Categorie @relation(fields: [categorieId], references: [id])
  variantes VarianteProduit[]
  medias MediaProduit[]
  publications PublicationProduit[]
  favoris FavoriProduit[]
  signalements Signalement[]
  lignesCommande LigneArticleCommande[]
  @@index([boutiqueId])
  @@index([categorieId])
  @@index([statut])
  @@index([dateCreation])
  @@map("produits")
}

model VarianteProduit {
  id String @id @default(uuid()) @db.Uuid
  produitId String @map("produit_id") @db.Uuid
  sku String @unique
  nom String
  attributs Json
  prix Decimal? @db.Decimal(12, 2)
  stockDisponible Int @default(0) @map("stock_disponible")
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateModification DateTime @updatedAt @map("date_modification") @db.Timestamptz(3)
  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  articlesPanier ArticlePanier[]
  lignesCommande LigneArticleCommande[]
  @@index([produitId])
  @@map("variantes_produits")
}

model Media {
  id String @id @default(uuid()) @db.Uuid
  typeMedia TypeMedia @map("type_media")
  cleStockage String @map("cle_stockage")
  typeMime String @map("type_mime")
  taille BigInt
  largeur Int?
  hauteur Int?
  duree Int?
  statutTraitement StatutTraitementMedia @default(PROCESSING) @map("statut_traitement")
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  mediaProduits MediaProduit[]
  mediaPublications MediaPublication[]
  stories Story[]
  piecesJointes PieceJointeMessage[]
  preuvesLitige PreuveLitige[]
  @@index([statutTraitement])
  @@index([dateCreation])
  @@map("medias")
}

model MediaProduit {
  id String @id @default(uuid()) @db.Uuid
  produitId String @map("produit_id") @db.Uuid
  mediaId String @map("media_id") @db.Uuid
  ordre Int @default(0)
  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  @@unique([produitId, mediaId])
  @@index([mediaId])
  @@map("medias_produits")
}

model Publication {
  id String @id @default(uuid()) @db.Uuid
  boutiqueId String @map("boutique_id") @db.Uuid
  contenu String?
  type TypePublication
  visibilite VisibiliteContenu @default(PUBLIC)
  statut StatutPublication @default(PROCESSING)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateModification DateTime @updatedAt @map("date_modification") @db.Timestamptz(3)
  boutique Boutique @relation(fields: [boutiqueId], references: [id])
  medias MediaPublication[]
  produits PublicationProduit[]
  likes Aime[]
  commentaires Commentaire[]
  favoris FavoriPublication[]
  signalements Signalement[]
  @@index([boutiqueId])
  @@index([statut])
  @@index([dateCreation])
  @@map("publications")
}

model MediaPublication {
  id String @id @default(uuid()) @db.Uuid
  publicationId String @map("publication_id") @db.Uuid
  mediaId String @map("media_id") @db.Uuid
  ordre Int @default(0)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  @@unique([publicationId, mediaId])
  @@index([mediaId])
  @@map("medias_publications")
}

model PublicationProduit {
  id String @id @default(uuid()) @db.Uuid
  publicationId String @map("publication_id") @db.Uuid
  produitId String @map("produit_id") @db.Uuid
  ordre Int @default(0)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  produit Produit @relation(fields: [produitId], references: [id])
  @@unique([publicationId, produitId])
  @@index([produitId])
  @@map("publications_produits")
}

model Aime {
  id String @id @default(uuid()) @db.Uuid
  utilisateurId String @map("utilisateur_id") @db.Uuid
  publicationId String @map("publication_id") @db.Uuid
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  @@unique([utilisateurId, publicationId])
  @@index([publicationId])
  @@map("aimes")
}

model Commentaire {
  id String @id @default(uuid()) @db.Uuid
  utilisateurId String @map("utilisateur_id") @db.Uuid
  publicationId String @map("publication_id") @db.Uuid
  contenu String
  statut StatutCommentaire @default(VISIBLE)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  signalements Signalement[]
  @@index([utilisateurId])
  @@index([publicationId])
  @@index([statut])
  @@map("commentaires")
}

model FavoriPublication {
  id String @id @default(uuid()) @db.Uuid
  utilisateurId String @map("utilisateur_id") @db.Uuid
  publicationId String @map("publication_id") @db.Uuid
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  @@unique([utilisateurId, publicationId])
  @@index([publicationId])
  @@map("favoris_publications")
}

model FavoriProduit {
  id String @id @default(uuid()) @db.Uuid
  utilisateurId String @map("utilisateur_id") @db.Uuid
  produitId String @map("produit_id") @db.Uuid
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  @@unique([utilisateurId, produitId])
  @@index([produitId])
  @@map("favoris_produits")
}

model Story {
  id String @id @default(uuid()) @db.Uuid
  boutiqueId String @map("boutique_id") @db.Uuid
  mediaId String @map("media_id") @db.Uuid
  ordreCreation Int @default(0) @map("ordre_creation")
  visibilite VisibiliteContenu @default(PUBLIC)
  statut StatutPublication @default(PROCESSING)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateExpiration DateTime @map("date_expiration") @db.Timestamptz(3)
  boutique Boutique @relation(fields: [boutiqueId], references: [id])
  media Media @relation(fields: [mediaId], references: [id])
  @@index([boutiqueId])
  @@index([dateExpiration])
  @@map("stories")
}

model Abonnement {
  id String @id @default(uuid()) @db.Uuid
  utilisateurId String @map("utilisateur_id") @db.Uuid
  vendeurId String @map("vendeur_id") @db.Uuid
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  statut StatutAbonnement @default(ACTIF)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  vendeur Vendeur @relation(fields: [vendeurId], references: [id], onDelete: Cascade)
  @@unique([utilisateurId, vendeurId])
  @@index([vendeurId])
  @@map("abonnements")
}

model Conversation {
  id String @id @default(uuid()) @db.Uuid
  type TypeConversation
  statut StatutConversation @default(ACTIVE)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  dateDerniereActivite DateTime @default(now()) @map("date_derniere_activite") @db.Timestamptz(3)
  participants ParticipantConversation[]
  messages Message[]
  @@index([statut])
  @@index([dateDerniereActivite])
  @@map("conversations")
}

model ParticipantConversation {
  conversationId String @map("conversation_id") @db.Uuid
  utilisateurId String @map("utilisateur_id") @db.Uuid
  dateEntree DateTime @default(now()) @map("date_entree") @db.Timestamptz(3)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  @@id([conversationId, utilisateurId])
  @@index([utilisateurId])
  @@map("participants_conversations")
}

model Message {
  id String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  expediteurId String @map("expediteur_id") @db.Uuid
  contenu String?
  type TypeMessage
  statut StatutMessage @default(ENVOYE)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expediteur Utilisateur @relation("ExpediteurMessage", fields: [expediteurId], references: [id])
  piecesJointes PieceJointeMessage[]
  @@index([conversationId])
  @@index([expediteurId])
  @@index([dateCreation])
  @@map("messages")
}

model PieceJointeMessage {
  id String @id @default(uuid()) @db.Uuid
  messageId String @map("message_id") @db.Uuid
  mediaId String @map("media_id") @db.Uuid
  type TypeMedia
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id])
  @@index([messageId])
  @@index([mediaId])
  @@map("pieces_jointes_messages")
}

model DossierKyc {
  id String @id @default(uuid()) @db.Uuid
  vendeurId String @map("vendeur_id") @db.Uuid
  statut StatutKyc @default(EN_ATTENTE)
  dateSoumission DateTime @default(now()) @map("date_soumission") @db.Timestamptz(3)
  dateValidation DateTime? @map("date_validation") @db.Timestamptz(3)
  dateRejet DateTime? @map("date_rejet") @db.Timestamptz(3)
  motifRejet String? @map("motif_rejet")
  vendeur Vendeur @relation(fields: [vendeurId], references: [id])
  documents DocumentKyc[]
  verifications VerificationKyc[]
  revues RevueKyc[]
  @@index([vendeurId])
  @@index([statut])
  @@map("dossiers_kyc")
}

model DocumentKyc {
  id String @id @default(uuid()) @db.Uuid
  dossierKycId String @map("dossier_kyc_id") @db.Uuid
  typeDocument TypeDocumentKyc @map("type_document")
  cleStockage String @map("cle_stockage")
  nomOriginal String @map("nom_original")
  typeMime String @map("type_mime")
  taille BigInt
