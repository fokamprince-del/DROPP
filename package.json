{
  "name": "dropp",
  "version": "1.0.0",
  "description": "DROPP - Social commerce marketplace",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",

    "postinstall": "pnpm run generer",
    "generer": "prisma generate && pnpm --filter @dropp/contrats build",

    "api:dev": "pnpm --filter api start:dev",
    "api:build": "pnpm --filter api build",
    "api:start": "pnpm --filter api start:prod",
    "api:format": "pnpm --filter api format",
    "api:lint": "pnpm --filter api lint",
    "api:test": "pnpm --filter api test",
    "api:test:watch": "pnpm --filter api test:watch",
    "api:test:e2e": "pnpm --filter api test:e2e",
    "api:typecheck": "pnpm --filter api exec tsc --noEmit",

    "worker:dev": "pnpm --filter worker start:dev",
    "worker:build": "pnpm --filter worker build",
    "worker:start": "pnpm --filter worker start:prod",
    "worker:format": "pnpm --filter worker format",
    "worker:lint": "pnpm --filter worker lint",
    "worker:test": "pnpm --filter worker test",
    "worker:test:watch": "pnpm --filter worker test:watch",
    "worker:test:e2e": "pnpm --filter worker test:e2e",
    "worker:typecheck": "pnpm --filter worker exec tsc --noEmit",

    "contrats:dev": "pnpm --filter @dropp/contrats dev",
    "contrats:build": "pnpm --filter @dropp/contrats build",
    "contrats:typecheck": "pnpm --filter @dropp/contrats typecheck",

    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:studio": "prisma studio",

    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:restart": "docker compose restart postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:status": "docker compose ps postgres",

    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose stop redis",
    "redis:restart": "docker compose restart redis",
    "redis:logs": "docker compose logs -f redis",
    "redis:status": "docker compose ps redis",
    "redis:cli": "docker compose exec redis redis-cli -a ${REDIS_PASSWORD}",

    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:status": "docker compose ps",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:reset": "prisma migrate reset",

    "format": "pnpm --filter api --filter worker format ",
    "format:check": "pnpm --filter api exec prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "7.10.0",
    "turbo": "^2.10.12"
  }
}