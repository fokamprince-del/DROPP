{
  "name": "@dropp/database",
  "version": "1.0.0",
  "description": "Client Prisma et schéma partagés entre les apps",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate --config prisma.config.ts",
    "migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "migrate:status": "prisma migrate status --config prisma.config.ts",
    "migrate:reset": "prisma migrate reset --config prisma.config.ts",
    "studio": "prisma studio --config prisma.config.ts",
    "validate": "prisma validate --config prisma.config.ts",
    "format": "prisma format --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  }
}