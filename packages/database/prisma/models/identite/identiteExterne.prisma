model IdentiteExterne {
  id            String              @id @default(uuid()) @db.Uuid
  utilisateurId String              @map("utilisateur_id") @db.Uuid
  fournisseur   FournisseurIdentite
  sujet         String
  email         String?
  emailVerifie  Boolean             @default(false) @map("email_verifie")
  dateCreation  DateTime            @default(now()) @map("date_creation") @db.Timestamptz(3)

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([fournisseur, sujet])
  @@unique([utilisateurId, fournisseur])
  @@map("identites_externes")
}
