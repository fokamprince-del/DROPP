model DossierKyc {
  id        String    @id @default(uuid()) @db.Uuid
  vendeurId String    @map("vendeur_id") @db.Uuid
  statut    StatutKyc @default(EN_ATTENTE)

  // Données CNI saisies manuellement (assistées par OCR)
  nomLegal          String?   @map("nom_legal")
  prenomLegal       String?   @map("prenom_legal")
  numeroCni         String?   @map("numero_cni")
  dateNaissance     DateTime? @map("date_naissance") @db.Date
  lieuNaissance     String?   @map("lieu_naissance")
  dateEtablissement DateTime? @map("date_etablissement") @db.Date
  dateExpiration    DateTime? @map("date_expiration_cni") @db.Date

  // Résultat vérification faciale
  scoreFaceMatch Decimal? @map("score_face_match") @db.Decimal(5, 4)

  dateSoumission DateTime  @default(now()) @map("date_soumission") @db.Timestamptz(3)
  dateValidation DateTime? @map("date_validation") @db.Timestamptz(3)
  dateRejet      DateTime? @map("date_rejet") @db.Timestamptz(3)
  motifRejet     String?   @map("motif_rejet")

  vendeur       Vendeur           @relation(fields: [vendeurId], references: [id])
  documents     DocumentKyc[]
  verifications VerificationKyc[]
  revues        RevueKyc[]

  @@index([vendeurId])
  @@index([statut])
  @@map("dossiers_kyc")
}
