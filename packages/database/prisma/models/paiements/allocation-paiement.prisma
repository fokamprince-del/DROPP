model AllocationPaiement {
  id           String   @id @default(uuid()) @db.Uuid
  paiementId   String   @map("paiement_id") @db.Uuid
  commandeId   String   @map("commande_id") @db.Uuid
  montant      Decimal  @db.Decimal(12, 2)
  dateCreation DateTime @default(now()) @map("date_creation") @db.Timestamptz(3)
  paiement     Paiement @relation(fields: [paiementId], references: [id], onDelete: Cascade)
  commande     Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@unique([paiementId, commandeId])
  @@index([commandeId])
  @@map("allocations_paiements")
}
