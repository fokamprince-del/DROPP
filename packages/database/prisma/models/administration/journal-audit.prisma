model JournalAudit {
  id               String       @id @default(uuid()) @db.Uuid
  administrateurId String?      @map("administrateur_id") @db.Uuid
  action           String
  resourceType     String       @map("resource_type")
  resourceId       String       @map("resource_id")
  adresseIp        String?      @map("adresse_ip")
  details          Json?
  dateCreation     DateTime     @default(now()) @map("date_creation") @db.Timestamptz(3)
  administrateur   Utilisateur? @relation("AdministrateurAudit", fields: [administrateurId], references: [id])

  @@index([administrateurId])
  @@index([resourceType, resourceId])
  @@index([dateCreation])
  @@map("journaux_audit")
}
