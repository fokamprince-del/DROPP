model Signalement {
  id            String              @id @default(uuid()) @db.Uuid
  utilisateurId String              @map("utilisateur_id") @db.Uuid
  publicationId String?             @map("publication_id") @db.Uuid
  commentaireId String?             @map("commentaire_id") @db.Uuid
  produitId     String?             @map("produit_id") @db.Uuid
  boutiqueId    String?             @map("boutique_id") @db.Uuid
  messageId     String?             @map("message_id") @db.Uuid
  motif        String
  description   String?
  statut        StatutSignalement   @default(OUVERT)
  priorite      PrioriteSignalement @default(NORMALE)
  dateCreation  DateTime            @default(now()) @map("date_creation") @db.Timestamptz(3)
  utilisateur   Utilisateur         @relation("EmetteurSignalement", fields: [utilisateurId], references: [id])
  publication   Publication?        @relation(fields: [publicationId], references: [id])
  commentaire   Commentaire?        @relation(fields: [commentaireId], references: [id])
  produit       Produit?            @relation(fields: [produitId], references: [id])
  boutique      Boutique?           @relation(fields: [boutiqueId], references: [id])
  message       Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([utilisateurId])
  @@index([boutiqueId])
  @@index([messageId])
  @@index([publicationId])
  @@index([commentaireId])
  @@index([produitId])
  @@index([statut])
  @@index([priorite])
  @@map("signalements")
}
