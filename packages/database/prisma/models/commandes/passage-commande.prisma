model PassageCommande {
  id            String                @id @default(uuid()) @db.Uuid
  utilisateurId String                @map("utilisateur_id") @db.Uuid
  panierId      String                @map("panier_id") @db.Uuid
  statut        StatutPassageCommande @default(EN_COURS)
  montantTotal  Decimal               @map("montant_total") @db.Decimal(12, 2)
  devise        String                @default("XAF")
  dateCreation  DateTime              @default(now()) @map("date_creation") @db.Timestamptz(3)
  utilisateur   Utilisateur           @relation(fields: [utilisateurId], references: [id])
  panier        Panier                @relation(fields: [panierId], references: [id])
  commande      Commande?
  paiements     Paiement[]
  reservations  ReservationStock[]

  @@index([utilisateurId])
  @@index([panierId])
  @@index([statut])
  @@map("passages_commandes")
}
