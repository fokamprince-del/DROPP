APP_NAME=DROPP API
NODE_ENV=development
PORT=3000
# Nombre exact de reverse proxys devant l'API (0 = aucun). Trop haut = IP falsifiable.
TRUST_PROXY=0
# Origines web autorisées (back-office), séparées par des virgules. Vide = aucune (apps mobiles).
CORS_ORIGINS=

DATABASE_URL="postgresql://db_user:db_password@localhost:5432/db_name"
DATABASE_POOL_MAX=10

JWT_ACCESS_SECRET=change-moi-avec-un-secret-aleatoire-tres-long

JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d

AUTH_PASSWORD_PEPPER="change-moi-avec-un-pepper-aleatoire-tres-long"
AUTH_OTP_PEPPER="change-moi-avec-un-pepper-aleatoire-tres-long"
AUTH_VERIFICATION_SECRET="change-moi-avec-un-pepper-aleatoire-tres-long"
AUTH_VERIFICATION_TTL=15m

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_local_only
REDIS_OTP_TTL=300
REDIS_OTP_COOLDOWN=60
REDIS_OTP_MAX_TENTATIVES=5
REDIS_OTP_MAX_ENVOIS_HEURE=5
REDIS_IDEMPOTENCE_TTL=86400

# Délai pour payer une commande avant annulation automatique (stock rendu)
COMMANDE_DELAI_PAIEMENT_MINUTES=30

# ─── Stockage fichiers (Cloudflare R2, compatible S3) ───
# "stub" = pas de vrai stockage (dev), "r2" = Cloudflare R2
STOCKAGE_DRIVER=stub
# Dashboard Cloudflare → R2 → "Account ID" (colonne de droite)
R2_ACCOUNT_ID=
# R2 → Manage API tokens → Create API token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nom du bucket créé dans R2
R2_BUCKET=dropp-medias
# Bucket SANS accès public (pièces d'identité KYC, messagerie, contenus abonnés),
# lu par URL signée. Obligatoire et distinct de R2_BUCKET en production.
R2_BUCKET_PRIVE=dropp-prive
# Endpoint S3 : https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# URL publique de lecture : domaine perso (https://cdn.dropp.cm) ou https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
# Durée de validité des URL d'upload signées (secondes)
R2_UPLOAD_URL_TTL=600
# true seulement avec un domaine perso Cloudflare + Images > Transformations activées (r2.dev ne redimensionne pas)
R2_TRANSFORMATIONS_IMAGES=false

SEED_ADMIN_TELEPHONE=+237600000000
SEED_ADMIN_MOT_DE_PASSE=MotDePasseForte2024!
