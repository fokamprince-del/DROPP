NODE_ENV=development
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=votre_mot_de_passe_redis

# ─── Emails (Resend) ───
# Vide = stub (les emails, dont les codes OTP, sont seulement loggés).
# resend.com → API Keys → Create API Key (permission "Sending access")
RESEND_API_KEY=
# Expéditeur : le domaine doit être vérifié dans Resend → Domains.
# Pour tester sans domaine : "DROPP <onboarding@resend.dev>" (n'envoie qu'à l'adresse de ton compte Resend).
EMAIL_EXPEDITEUR=DROPP <no-reply@dropp.cm>
EMAIL_REPONDRE_A=

# ─── Firebase Cloud Messaging (notifications push) ───
# Vide = stub (les push sont seulement loggés).
# Console Firebase → Paramètres du projet → Comptes de service → Générer une nouvelle clé privée
# puis recopier project_id, client_email et private_key du JSON téléchargé.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Garder les \n tels quels, entre guillemets : "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=


DATABASE_URL="postgresql://db_user:db_password@localhost:5432/db_name"
DATABASE_POOL_MAX=5

# # ─── Stockage fichiers (Cloudflare R2, compatible S3) ───
# # "stub" = pas de vrai stockage (dev), "r2" = Cloudflare R2
# STOCKAGE_DRIVER=stub
# # R2 → Manage API tokens → Create API token (Object Read & Write)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# # Nom du bucket créé dans R2
# R2_BUCKET=dropp-medias
# # Bucket SANS accès public (pièces jointes de messagerie, lues par URL signée)
# R2_BUCKET_PRIVE=dropp-prive
# # Endpoint S3 : https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

FACEPP_API_KEY=
FACEPP_API_SECRET=